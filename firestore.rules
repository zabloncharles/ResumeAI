rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /resumes/{resumeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /resumes/{resumeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && resumeId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resumeId == request.auth.uid;
    }
    
    // Allow authenticated users to read analytics
    match /analytics/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only allow writes through admin SDK
    }
    
    // Study sets rules - strict user-based access control
    match /studySets/{setId} {
      // Users can only read their own sets or public sets
      allow read: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid
          || resource.data.isPublic == true
          || resource.data.keys().hasAny(['shareCode']));
      
      // Users can only create/update their own sets
      allow create: if request.auth != null && 
        request.resource.data.createdBy == request.auth.uid;
      
      allow update: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;
      
      // Users can only delete their own sets
      allow delete: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;
      
      // Flashcards subcollection - inherit parent permissions
      match /flashcards/{cardId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/studySets/$(setId)).data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/studySets/$(setId)).data.isPublic == true
          || get(/databases/$(database)/documents/studySets/$(setId)).data.keys().hasAny(['shareCode'])
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/studySets/$(setId)).data.createdBy == request.auth.uid;
      }
    }
    
    match /studyFolders/{folderId} {
      allow read: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Public sets rules
    match /publicSets/{publicCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /privateSetShares/{shareCode} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
