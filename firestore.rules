rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isSelf(userId);

      match /resumes/{resumeId} {
        allow read, write: if isSelf(userId);
      }

      match /coverLetters/{coverLetterId} {
        allow read, write: if isSelf(userId);
      }
    }
    
    match /resumes/{resumeId} {
      allow read: if signedIn() && (resumeId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && resumeId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resumeId == request.auth.uid;
    }
    
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Study sets rules - strict user-based access control
    match /studySets/{setId} {
      // Users can only read their own sets or public sets
      allow read: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid
          || resource.data.isPublic == true
          || resource.data.keys().hasAny(['shareCode']));
      
      // Users can only create/update their own sets
      allow create: if request.auth != null && 
        request.resource.data.createdBy == request.auth.uid;
      
      allow update: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;
      
      // Users can only delete their own sets
      allow delete: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;
      
      // Flashcards subcollection - inherit parent permissions
      match /flashcards/{cardId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/studySets/$(setId)).data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/studySets/$(setId)).data.isPublic == true
          || get(/databases/$(database)/documents/studySets/$(setId)).data.keys().hasAny(['shareCode'])
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/studySets/$(setId)).data.createdBy == request.auth.uid;
      }
    }
    
    match /studyFolders/{folderId} {
      allow read: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Public sets rules
    match /publicSets/{publicCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /privateSetShares/{shareCode} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /podcasts/{podcastId} {
      allow read: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    match /podcastJobs/{jobId} {
      allow read: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }
  }
}
